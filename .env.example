# Скопируй в .env и заполни

# БД: SQLite для локала, Postgres для прода
DATABASE_URL=sqlite+aiosqlite:///./velcode.db
# DATABASE_URL=postgresql+asyncpg://velcode:PASSWORD@localhost/velcode

# Email (smtp.mail.ru для inbox.ru)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=velcode@inbox.ru
SMTP_PASSWORD=
NOTIFY_EMAIL=velcode@inbox.ru

# Битрикс24 входящий вебхук
BITRIX_WEBHOOK_URL=

# CORS — через запятую (без пробелов)
# CORS_ORIGINS=["https://velcode.ru"]
